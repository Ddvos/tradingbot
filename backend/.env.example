# Copy this file to .env and fill in your values. .env is gitignored —
# secrets never go into git.

# PostgreSQL connection (matches the docker-compose.yml defaults; change if
# you run your own Postgres)
DATABASE_URL=postgresql+psycopg://tradingbot:tradingbot@localhost:5432/tradingbot

# Kraken Futures API keys — NOT needed yet: backfill uses the public charts
# API. Required from Slice 5+ (account data, order placement).
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Frontend origins allowed to call the API, as a JSON list (optional;
# defaults to the SvelteKit dev server)
# CORS_ORIGINS=["http://localhost:5173"]
