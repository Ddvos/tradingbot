# Copy this file to .env and fill in your values. .env is gitignored —
# secrets never go into git.

# PostgreSQL connection (matches the docker-compose.yml defaults; change if
# you run your own Postgres)
DATABASE_URL=postgresql+psycopg://tradingbot:tradingbot@localhost:5432/tradingbot

# Kraken Futures API keys — NOT needed yet: backfill uses the public charts
# API. Required from Slice 5+ (account data, order placement).
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Frontend origins allowed to call the API, as a JSON list (optional;
# defaults to the SvelteKit dev server)
# CORS_ORIGINS=["http://localhost:5173"]

# Where scripts/walkforward.py writes its run artifacts, relative to the
# API's working directory (optional; the default assumes uvicorn runs from
# backend/)
# WALKFORWARD_DIR=data/processed/walkforward

# Paper trading (Slice 5) — all optional, defaults shown
# MODELS_DIR=data/models
# PAPER_SYMBOL=PF_XBTUSD
# PAPER_INITIAL_CAPITAL=10000
